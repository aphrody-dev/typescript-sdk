{
    "name": "@modelcontextprotocol/sdk",
    "private": true,
    "version": "2.0.0-alpha.0",
    "description": "Model Context Protocol implementation for TypeScript",
    "license": "Apache-2.0",
    "author": "Model Context Protocol a Series of LF Projects, LLC.",
    "homepage": "https://modelcontextprotocol.io",
    "bugs": "https://github.com/modelcontextprotocol/typescript-sdk/issues",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modelcontextprotocol/typescript-sdk.git"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "modelcontextprotocol",
        "mcp"
    ],
    "scripts": {
        "fetch:schema-twins": "bun scripts/fetch-schema-twins.ts",
        "fetch:spec-examples": "bun scripts/fetch-spec-examples.ts",
        "fetch:spec-types": "bun scripts/fetch-spec-types.ts",
        "sync:snippets": "bun scripts/sync-snippets.ts",
        "check:skills": "bun scripts/check-skills.ts",
        "examples:oauth-server:w": "bun run --filter @mcp-examples/oauth dev",
        "run:examples": "bun scripts/examples/run-examples.ts",
        "docs:examples": "bun scripts/run-guide-examples.ts",
        "docs:api": "typedoc",
        "docs:dev": "vitepress dev docs",
        "docs:build": "bun run docs:api && vitepress build docs",
        "docs:multi": "bash scripts/build-docs-site.sh",
        "docs:check": "bun run docs:build",
        "typecheck:all": "bun run --filter '*' typecheck",
        "build:all": "bun run --filter './packages/**' build",
        "ci:publish": "bun run build:all && changeset publish",
        "prepack:all": "bun run --filter './packages/**' prepack",
        "lint:all": "bun run sync:snippets --check && bun run check:skills && bun run --filter '*' lint",
        "lint:fix:all": "bun run sync:snippets && bun run --filter '*' lint:fix",
        "check:all": "bun run sync:snippets --check && bun run check:skills && bun run --filter '*' typecheck && bun run --filter '*' lint && bun run docs:check",
        "test:all": "bun test",
        "prepare": "lefthook install",
        "test": "bun test",
        "test:conformance:client": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:client",
        "test:conformance:client:all": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:client:all",
        "test:conformance:client:run": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:client:run",
        "test:conformance:server": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:server",
        "test:conformance:server:draft": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:server:draft",
        "test:conformance:server:extensions": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:server:extensions",
        "test:conformance:server:all": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:server:all",
        "test:conformance:server:run": "bun run --filter @modelcontextprotocol/test-conformance test:conformance:server:run",
        "test:conformance:all": "bun run test:conformance:client:all && bun run test:conformance:server:all"
    },
    "devDependencies": {
        "@cfworker/json-schema": "catalog:runtimeShared",
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@eslint/js": "catalog:devTools",
        "@modelcontextprotocol/client": "workspace:^",
        "@modelcontextprotocol/node": "workspace:^",
        "@modelcontextprotocol/server": "workspace:^",
        "@types/cors": "catalog:devTools",
        "@types/express": "catalog:devTools",
        "@types/express-serve-static-core": "catalog:devTools",
        "@types/node": "^24.10.1",
        "@types/supertest": "catalog:devTools",
        "@typescript/native-preview": "catalog:devTools",
        "bun-types": "catalog:devTools",
        "eslint": "catalog:devTools",
        "eslint-config-prettier": "catalog:devTools",
        "eslint-plugin-n": "catalog:devTools",
        "fast-glob": "^3.3.3",
        "lefthook": "^2.0.16",
        "prettier": "catalog:devTools",
        "supertest": "catalog:devTools",
        "tsdown": "catalog:devTools",
        "tslib": "^2.8.1",
        "typedoc": "catalog:devTools",
        "typedoc-plugin-markdown": "^4.12.0",
        "typedoc-vitepress-theme": "^1.1.3",
        "typescript": "catalog:devTools",
        "typescript-eslint": "catalog:devTools",
        "vitepress": "^1.6.4",
        "zod": "catalog:runtimeShared"
    },
    "resolutions": {
        "strip-ansi": "6.0.1"
    },
    "workspaces": {
        "packages": [
            "packages/*",
            "packages/middleware/*",
            "common/*",
            "examples",
            "examples/*",
            "test/*"
        ],
        "catalogs": {
            "devTools": {
                "@eslint/js": "^9.39.2",
                "@valibot/to-json-schema": "^1.5.0",
                "arktype": "^2.1.29",
                "valibot": "^1.2.0",
                "wrangler": "^4.14.4",
                "@types/cors": "^2.8.17",
                "@types/express": "^5.0.6",
                "@types/express-serve-static-core": "^5.1.0",
                "@types/supertest": "^6.0.2",
                "@typescript/native-preview": "^7.0.0-dev.20251217.1",
                "eslint": "^9.39.2",
                "eslint-config-prettier": "^10.1.8",
                "eslint-plugin-n": "^17.23.1",
                "prettier": "3.6.2",
                "supertest": "^7.0.0",
                "tsdown": "^0.18.0",
                "typedoc": "^0.28.14",
                "typescript": "^5.9.3",
                "typescript-eslint": "^8.48.1",
                "bun-types": "canary"
            },
            "runtimeClientOnly": {
                "jose": "^6.1.3"
            },
            "runtimeServerOnly": {
                "@hono/node-server": "^1.19.9 || ^2.1.3",
                "cors": "^2.8.5",
                "express": "^5.2.1",
                "fastify": "^5.2.0",
                "hono": "^4.11.4"
            },
            "otel": {
                "@opentelemetry/api": "^1.9.0",
                "@opentelemetry/context-async-hooks": "^3.0.0",
                "@opentelemetry/core": "^3.0.0",
                "@opentelemetry/sdk-metrics": "^3.0.0",
                "@opentelemetry/sdk-trace": "^3.0.0"
            },
            "runtimeShared": {
                "@cfworker/json-schema": "^4.1.1",
                "ajv": "^8.17.1",
                "ajv-formats": "^3.0.1",
                "json-schema-typed": "^8.0.2",
                "zod": "^4.2.0"
            }
        }
    }
}
